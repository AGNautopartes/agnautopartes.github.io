# === SUPABASE (Requerido) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === GEMINI (Google AI) - Opción 1 ===
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# === OPENROUTER - Opción 2 (gratis) ===
OPENROUTER_API_KEY=your_openrouter_api_key
USE_OPENROUTER=false  # true = usa OpenRouter, false = usa Gemini
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct  # Mixtral gratis
OPENROUTER_REFERER=https://agnautopartes.vercel.app
OPENROUTER_TITLE=AGN AutoPartes ERP

# === ADMIN ===
PASSWORD_ADMIN=your_admin_password