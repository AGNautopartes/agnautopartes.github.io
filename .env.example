# === SUPABASE (Requerido) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === GEMINI (Google AI) - Opción 1 ===
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# === OPENROUTER - Opción 2 (gratis) ===
OPENROUTER_API_KEY=your_openrouter_api_key
USE_OPENROUTER=false  # true = usa OpenRouter, false = usa Gemini
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct  # Default gratuito (sobrescrito por selector UI)
OPENROUTER_REFERER=https://agnautopartes.vercel.app  # Para estadísticas en OpenRouter
OPENROUTER_TITLE=AGN AutoPartes ERP  # Nombre de la app en OpenRouter

# === ARIA 2 (Agente del ERP) ===
# Debe ser un modelo específico con soporte de tools. No usar openrouter/free.
ARIA_MODEL=minimax/minimax-m2.5:free
# Opcional: limita el selector del Admin a modelos previamente aprobados.
ARIA_ALLOWED_MODELS=minimax/minimax-m2.5:free

# === CONFIGURACIÓN AVANZADA ===
# Temperatura del modelo (0-1). 0.7 es balanceado. Cambiar si usas otro frontend.
OPENROUTER_TEMPERATURE=0.7

# === ADMIN ===
PASSWORD_ADMIN=your_admin_password
